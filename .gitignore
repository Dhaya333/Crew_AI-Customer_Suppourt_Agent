.env
.env.*
!.env.example
*.pem
*.key

# ---------- Python ----------
__pycache__/
*.py[cod]



# ---------- Virtual Environments ----------
venv/
env/
ENV/
.venv/
.conda/

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Testing / Coverage ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# ---------- Type Checkers / Linters ----------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store


# ---------- AI / Vector DB / Cache ----------
chroma_db/
*.sqlite3
*.db
.chroma/
embeddings_cache/
.cache/
crewai_storage/
memory/
*.faiss
*.index

# ---------- Output / Temp Files ----------
output/
outputs/
tmp/
temp/
*.tmp



# ---------- Package Managers ----------
node_modules/
package-lock.json
poetry.lock
Pipfile.lock
uv.lock
