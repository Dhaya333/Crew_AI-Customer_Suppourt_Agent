# ============================================
# .env.example — Customer Support Agent (CrewAI + Gemini)
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# ---------- LLM Provider: Gemini ----------
GEMINI_API_KEY=your_gemini_api_key_here
MODEL=gemini/gemini-2.5-flash

# ---------- Search Tool (optional, used by SerperDevTool) ----------
SERPER_API_KEY=your_serper_api_key_here

# ---------- App Config ----------
CREW_MEMORY_ENABLED=true
CREW_VERBOSE=true

# ---------- Google Form / Sheet (for pulling inquiries) ----------
GOOGLE_SHEET_ID=your_sheet_id_from_the_url
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ---------- Gmail (for sending the response) ----------
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

